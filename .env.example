# Copie este arquivo para .env e ajuste os valores.
# NÃO coloque segredos reais aqui: este projeto é apenas um protótipo acadêmico.

# --- Banco de dados (usado pelo Docker Compose) ---
POSTGRES_DB=telemed
POSTGRES_USER=telemed
# Defina uma senha local qualquer no seu .env (não versionar).
POSTGRES_PASSWORD=troque-esta-senha

# URL usada pela aplicação. No Docker Compose o host é "db".
# Para executar fora do Docker, use localhost e a porta do seu PostgreSQL.
DATABASE_URL=postgresql+psycopg://telemed:troque-esta-senha@db:5432/telemed

# --- Aplicação ---
# Fuso horário usado para exibir e cadastrar horários.
APP_TIMEZONE=America/Sao_Paulo
# Duração da sessão de login, em horas.
SESSION_HOURS=8
# Use true apenas quando servir a aplicação via HTTPS.
COOKIE_SECURE=false
# Popula dados fictícios automaticamente ao iniciar (somente se o banco estiver vazio).
SEED_ON_START=true
# Senha das contas fictícias criadas pelo seed.
DEMO_PASSWORD=Demo@1234

# --- WebRTC ---
# Servidores STUN separados por vírgula. Vazio = apenas candidatos locais
# (suficiente para testar na mesma máquina ou na mesma rede).
# Exemplo de STUN público gratuito: stun:stun.l.google.com:19302
STUN_URLS=
